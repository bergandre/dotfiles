unalias ls 2>/dev/null

ls() {
  (( $# == 0 )) && command lsd -A || command lsd "$@"
}

# splits of one Ghostty window share its window id (Hyprland on linux, yabai on mac), so the note
# is stored per window and a new pane loads it on startup (the window is still focused right after the split key)
if [[ $TERM_PROGRAM == ghostty ]]; then
  if (( $+commands[hyprctl] )); then
    _note_win=$(hyprctl activewindow -j 2>/dev/null | jq -r 'select(.class == "com.mitchellh.ghostty") | .address')
  elif (( $+commands[yabai] )); then
    _note_win=$(yabai -m query --windows --window 2>/dev/null | jq -r 'select(.app == "Ghostty") | .id')
  fi
  # macOS has no XDG_RUNTIME_DIR, $TMPDIR is its per-user temp dir
  [[ -n $_note_win ]] && _note_file="${XDG_RUNTIME_DIR:-$TMPDIR}/pane-notes/$_note_win"
  [[ -r $_note_file ]] && export PANE_NOTE=$(<$_note_file)
fi

note() {
  if (( $# == 0 )); then
    unset PANE_NOTE
    [[ -n $_note_file ]] && rm -f "$_note_file"
  else
    export PANE_NOTE="$*"
    [[ -n $_note_file ]] && mkdir -p "${_note_file:h}" && print -r -- "$*" > "$_note_file"
  fi
}

bg() {
  "$@" >/dev/null 2>&1 & disown
}

uss() {
    sudo pacman -Syuu && sudo shutdown "$@"
}

hochu() {
    yay -S "$@" --noconfirm
}

extract () {
    if [ ! -f "$1" ]
    then
        echo "'$1' does not exist."
        return 1
    fi
    case "$1" in
        (*.tar.bz2) tar xvjf "$1" ;;
        (*.tar.xz) tar xvJf "$1" ;;
        (*.tar.gz) tar xvzf "$1" ;;
        (*.bz2) bunzip2 "$1" ;;
        (*.rar) rar x "$1" ;;
        (*.gz) gunzip "$1" ;;
        (*.tar) tar xvf "$1" ;;
        (*.tbz2) tar xvjf "$1" ;;
        (*.tgz) tar xvzf "$1" ;;
        (*.zip) unzip "$1" ;;
        (*.Z) uncompress "$1" ;;
        (*.xz) xz -d "$1" ;;
        (*.7z) 7z x "$1" ;;
        (*.a) ar x "$1" ;;
        (*) echo "Unable to extract '$1'." ;;
    esac
}
