// Shared bar lives in bar.jsonc; each bar here only overrides what differs.
// Keys in these objects win over the included file.
[
  {
    "include": "~/.config/waybar/bar.jsonc",
    "output": "!DP-1"
  },
  {
    // DP-1 is the portrait monitor: no window class, no countdown
    "include": "~/.config/waybar/bar.jsonc",
    "output": "DP-1",
    "modules-left": [
      "group/left1",
      "group/left2",
      "group/left4"
    ]
  }
]
