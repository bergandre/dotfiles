{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["tray", "network", "idle_inhibitor", "clock"],
    
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "active-only": false
    },
    
    "hyprland/window": {
        "max-length": 50,
        "separate-outputs": true
    },
    
    "tray": {
        "spacing": 10
    },
    
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "idle_inhibitor": {
    "format": "{icon}",
    "start-activated": true,
    "format-icons": {
        "activated": "", 
        "deactivated": ""
    }},
"pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon}",
    "format-muted": "",
    "format-icons": {
        "headphone": "",
        "hands-free": "",
        "headset": "",
        "phone": "",
        "portable": "",
        "car": "",
        "default": ["", ""]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "ignored-sinks": ["Easy Effects Sink"]
}
}
