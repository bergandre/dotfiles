#░█▀▄░▀█▀░█▀█░█▀▄░█▀▀
#░█▀▄░░█░░█░█░█░█░▀▀█
#░▀▀░░▀▀▀░▀░▀░▀▀░░▀▀▀

cmd - return : open -na Ghostty
cmd - e : open -a Finder
# cmd - g : open -a Shortcat

# Cycle through windows
cmd - tab : yabai -m window --focus next || yabai -m window --focus first

# Center window
cmd - space : yabai -m window --grid 4:4:1:1:2:2; sketchybar --trigger window_focus

# Toggle split direction
cmd - j : yabai -m window --toggle split; sketchybar --trigger window_focus

# Swap window with adjacent windows
ctrl + alt - left  : yabai -m window --swap west; sketchybar --trigger window_focus
ctrl + alt - right : yabai -m window --swap east; sketchybar --trigger window_focus
ctrl + alt - up    : yabai -m window --swap north; sketchybar --trigger window_focus
ctrl + alt - down  : yabai -m window --swap south; sketchybar --trigger window_focus

# Toggle full screen
cmd - f : yabai -m window --toggle zoom-fullscreen; sketchybar --trigger window_focus

# Resize windows with keys
cmd + alt - h : yabai -m window --resize left:-20:0; sketchybar --trigger window_focus
cmd + alt - l : yabai -m window --resize right:20:0; sketchybar --trigger window_focus
cmd + alt - k : yabai -m window --resize top:0:-20; sketchybar --trigger window_focus
cmd + alt - j : yabai -m window --resize bottom:0:20; sketchybar --trigger window_focus

# Focus window (cmd + arrows) - crosses monitors
cmd - left  : yabai -m window --focus west || (yabai -m display --focus west && yabai -m window --focus first); sketchybar --trigger window_focus
cmd - right : yabai -m window --focus east || (yabai -m display --focus east && yabai -m window --focus first); sketchybar --trigger window_focus
cmd - up    : yabai -m window --focus north || (yabai -m display --focus north && yabai -m window --focus first); sketchybar --trigger window_focus
cmd - down  : yabai -m window --focus south || (yabai -m display --focus south && yabai -m window --focus first); sketchybar --trigger window_focus

# Move window (shift + cmd + arrows)
shift + cmd - left  : yabai -m window --swap west || yabai -m window --display west; sketchybar --trigger window_focus
shift + cmd - right : yabai -m window --swap east || yabai -m window --display east; sketchybar --trigger window_focus
shift + cmd - up    : yabai -m window --swap north || yabai -m window --display north; sketchybar --trigger window_focus
shift + cmd - down  : yabai -m window --swap south || yabai -m window --display south; sketchybar --trigger window_focus

# Focus monitor (hyper + W/A/S/D)
hyper - w : yabai -m display --focus north; sketchybar --trigger window_focus
hyper - a : yabai -m display --focus west; sketchybar --trigger window_focus
hyper - s : yabai -m display --focus south; sketchybar --trigger window_focus
hyper - d : yabai -m display --focus east; sketchybar --trigger window_focus

# Tab switching (like Hyprland's SUPER+ALT+left/right -> ctrl+pgup/pgdn)
cmd + alt - left : skhd -k "ctrl - pageup"
cmd + alt - right : skhd -k "ctrl - pagedown"



#░█░█░█▀█░█▀▄░█░█░█▀▀░█▀█░█▀█░█▀▀░█▀▀░█▀▀
#░█▄█░█░█░█▀▄░█▀▄░▀▀█░█▀▀░█▀█░█░░░█▀▀░▀▀█
#░▀░▀░▀▀▀░▀░▀░▀░▀░▀▀▀░▀░░░▀░▀░▀▀▀░▀▀▀░▀▀▀

cmd - 1 : yabai -m space --focus 1; sketchybar --trigger window_focus
cmd - 2 : yabai -m space --focus 2; sketchybar --trigger window_focus
cmd - 3 : yabai -m space --focus 3; sketchybar --trigger window_focus
cmd - 4 : yabai -m space --focus 4; sketchybar --trigger window_focus
cmd - 5 : yabai -m space --focus 5; sketchybar --trigger window_focus
cmd - 6 : yabai -m space --focus 6; sketchybar --trigger window_focus
cmd - 7 : yabai -m space --focus 7; sketchybar --trigger window_focus
cmd - 8 : yabai -m space --focus 8; sketchybar --trigger window_focus
cmd - 9 : yabai -m space --focus 9; sketchybar --trigger window_focus
cmd - 0 : yabai -m space --focus 10; sketchybar --trigger window_focus

# Second monitor workspaces (alt + 1-0 for spaces 11-20)
alt - 1 : yabai -m space --focus 11; sketchybar --trigger window_focus
alt - 2 : yabai -m space --focus 12; sketchybar --trigger window_focus
alt - 3 : yabai -m space --focus 13; sketchybar --trigger window_focus
alt - 4 : yabai -m space --focus 14; sketchybar --trigger window_focus
alt - 5 : yabai -m space --focus 15; sketchybar --trigger window_focus
alt - 6 : yabai -m space --focus 16; sketchybar --trigger window_focus
alt - 7 : yabai -m space --focus 17; sketchybar --trigger window_focus
alt - 8 : yabai -m space --focus 18; sketchybar --trigger window_focus
alt - 9 : yabai -m space --focus 19; sketchybar --trigger window_focus
alt - 0 : yabai -m space --focus 20; sketchybar --trigger window_focus

# Move window to second monitor workspaces (alt + shift + 1-0)
shift + alt - 1 : yabai -m window --space 11; yabai -m space --focus 11; sketchybar --trigger windows_on_spaces
shift + alt - 2 : yabai -m window --space 12; yabai -m space --focus 12; sketchybar --trigger windows_on_spaces
shift + alt - 3 : yabai -m window --space 13; yabai -m space --focus 13; sketchybar --trigger windows_on_spaces
shift + alt - 4 : yabai -m window --space 14; yabai -m space --focus 14; sketchybar --trigger windows_on_spaces
shift + alt - 5 : yabai -m window --space 15; yabai -m space --focus 15; sketchybar --trigger windows_on_spaces
shift + alt - 6 : yabai -m window --space 16; yabai -m space --focus 16; sketchybar --trigger windows_on_spaces
shift + alt - 7 : yabai -m window --space 17; yabai -m space --focus 17; sketchybar --trigger windows_on_spaces
shift + alt - 8 : yabai -m window --space 18; yabai -m space --focus 18; sketchybar --trigger windows_on_spaces
shift + alt - 9 : yabai -m window --space 19; yabai -m space --focus 19; sketchybar --trigger windows_on_spaces
shift + alt - 0 : yabai -m window --space 20; yabai -m space --focus 20; sketchybar --trigger windows_on_spaces

cmd - delete      : yabai -m space --focus 18; sketchybar --trigger window_focus
cmd - pageup      : yabai -m space --focus 17; sketchybar --trigger window_focus
cmd - pagedown    : yabai -m space --focus 18; sketchybar --trigger window_focus
cmd - home        : yabai -m space --focus 19; sketchybar --trigger window_focus
cmd - end         : yabai -m space --focus 20; sketchybar --trigger window_focus

#cmd - delete      : yabai -m space --focus 16; sketchybar --trigger window_focus
#cmd - home        : yabai -m space --focus 17; sketchybar --trigger window_focus
#cmd - end         : yabai -m space --focus 18; sketchybar --trigger window_focus
#cmd - pageup      : yabai -m space --focus 19; sketchybar --trigger window_focus
#cmd - pagedown    : yabai -m space --focus 20; sketchybar --trigger window_focus

cmd - 0x21 : yabai -m space --focus prev; sketchybar --trigger window_focus
cmd - 0x1E : yabai -m space --focus next; sketchybar --trigger window_focus

shift + cmd - 1 : yabai -m window --space 1; yabai -m space --focus 1; sketchybar --trigger windows_on_spaces
shift + cmd - 2 : yabai -m window --space 2; yabai -m space --focus 2; sketchybar --trigger windows_on_spaces
shift + cmd - 3 : yabai -m window --space 3; yabai -m space --focus 3; sketchybar --trigger windows_on_spaces
shift + cmd - 4 : yabai -m window --space 4; yabai -m space --focus 4; sketchybar --trigger windows_on_spaces
shift + cmd - 5 : yabai -m window --space 5; yabai -m space --focus 5; sketchybar --trigger windows_on_spaces
shift + cmd - 6 : yabai -m window --space 6; yabai -m space --focus 6; sketchybar --trigger windows_on_spaces
shift + cmd - 7 : yabai -m window --space 7; yabai -m space --focus 7; sketchybar --trigger windows_on_spaces
shift + cmd - 8 : yabai -m window --space 8; yabai -m space --focus 8; sketchybar --trigger windows_on_spaces
shift + cmd - 9 : yabai -m window --space 9; yabai -m space --focus 9; sketchybar --trigger windows_on_spaces
shift + cmd - 0 : yabai -m window --space 10; yabai -m space --focus 10; sketchybar --trigger windows_on_spaces
shift + cmd - delete      : yabai -m window --space 16; yabai -m space --focus 16; sketchybar --trigger windows_on_spaces
shift + cmd - pageup      : yabai -m window --space 17; yabai -m space --focus 19; sketchybar --trigger windows_on_spaces
shift + cmd - pagedown    : yabai -m window --space 18; yabai -m space --focus 20; sketchybar --trigger windows_on_spaces
shift + cmd - home        : yabai -m window --space 19; yabai -m space --focus 17; sketchybar --trigger windows_on_spaces
shift + cmd - end         : yabai -m window --space 20; yabai -m space --focus 18; sketchybar --trigger windows_on_spaces

shift + cmd - 0x21 : wid=$(yabai -m query --windows --window | jq -r '.id'); yabai -m window "$wid" --space prev; yabai -m space --focus prev; yabai -m window --focus "$wid"; sketchybar --trigger windows_on_spaces; sketchybar --trigger window_focus
shift + cmd - 0x1E : wid=$(yabai -m query --windows --window | jq -r '.id'); yabai -m window "$wid" --space next; yabai -m space --focus next; yabai -m window --focus "$wid"; sketchybar --trigger windows_on_spaces; sketchybar --trigger window_focus

# # --- Spotify Controls ---
hyper - space : osascript -e 'tell application "Spotify" to playpause'
hyper - right : osascript -e 'tell application "Spotify" to next track'
hyper - left : osascript -e 'tell application "Spotify" to previous track'
hyper - up : osascript -e 'tell application "Spotify" to set sound volume to (sound volume + 10)'
hyper - down : osascript -e 'tell application "Spotify" to set sound volume to (sound volume - 10)'

# # --- YouTube Controls (Now Playing, needs: brew install nowplaying-cli) ---
hyper - k : nowplaying-cli togglePlayPause
hyper - n : nowplaying-cli next
hyper - p : nowplaying-cli previous
hyper - 1 : t=$(nowplaying-cli get elapsedTime); nowplaying-cli seek $(( ${t%.*} - 5 ))
hyper - 2 : t=$(nowplaying-cli get elapsedTime); nowplaying-cli seek $(( ${t%.*} + 5 ))
hyper - 3 : osascript -e 'set volume output volume ((output volume of (get volume settings)) - 10)'
hyper - 4 : osascript -e 'set volume output volume ((output volume of (get volume settings)) + 10)'
